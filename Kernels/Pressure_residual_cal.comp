#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) buffer source
{
    float source_term[]; // current grid i think
};

layout(std430, binding = 1) buffer RHS
{
    float rhs[]; // current grid size
};

layout(std430, binding = 2) buffer Residual
{
    float residual[];          // current grid i think, this would be the RHS for the next steped down field if in the step down loop
};

uniform int current_cells_x;
uniform int current_cells_y;
uniform int current_cells_z;
uniform float dx;
uniform float dy;
uniform float dz;
uniform float stable_dt;
uniform float density;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if(x >= uint(current_cells_x) || y >= uint(current_cells_y) || z >= uint(current_cells_z))
        return;

    
    uint layer_stride = uint(current_cells_x) * uint(current_cells_y);

    uint id = z * layer_stride + y * current_cells_x + x;

    float pC = source_term[id];

    float pWest = (x > 0) ? source_term[id - 1] : pC;
    float pEast = (x + 1 < uint(current_cells_x)) ? source_term[id + 1] : pC;
    float pNorth = (y > 0) ? source_term[id - uint(current_cells_x)] : pC;
    float pSouth = (y + 1 < uint(current_cells_y)) ? source_term[id + uint(current_cells_x)] : pC;
    float pTop = (z > 0 ) ? source_term[id - layer_stride] : pC;
    float pBottom = (z < uint(current_cells_z - 1)) ? source_term[id + layer_stride] : pC;

    float dx2 = dx * dx;
    float dy2 = dy * dy;
    float dz2 = dz * dz;

    float laplacian = (pWest - 2.0 * pC + pEast) / dx2 + (pNorth - 2.0 * pC + pSouth) / dy2 + (pTop - 2.0 * pC + pBottom) / dz2;

    residual[id] = (density * rhs[id] / stable_dt) - laplacian;
}