//=================================================================================================================================
//THE REASON WE HAVE THIS SEPARATE KERNEL IS BECAUSE WE DO HARMONIC INTERPOLATION FOR MU EFF IN THIS K ASSEMBLY KERNEL, WHICH IS 
//FUNDAMENTALLY DIFFERENT THAN THE NORMAL AVERAGE WE DO FOR MOMENTUM EQUATION
//=================================================================================================================================

//---------------------------------------------------------------------------------------------------------------
//                          This kernel is ONLY for k-eps model and standard k-omega model
//---------------------------------------------------------------------------------------------------------------


#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

uniform uint grid_x;
uniform uint grid_y;
uniform uint grid_z;

uniform float dx;
uniform float dy;
uniform float dz;
uniform float dynamic_viscosity;

uniform bool is_omega_model;    //For verification
uniform bool is_k;    //For differentiating in k and omega

layout(std430, binding = 0) buffer AP
{
    float aP[];
};

layout(std430, binding = 1) buffer AW
{
    float aW[];
};

layout(std430, binding = 2) buffer AE
{
    float aE[];
};

layout(std430, binding = 3) buffer AS
{
    float aS[];
};

layout(std430, binding = 4) buffer AN
{
    float aN[];
};

layout(std430, binding = 5) buffer AB
{
    float aB[];
};

layout(std430, binding = 6) buffer AT
{
    float aT[];
};

layout(std430, binding = 7) readonly buffer MuEff
{
    float mu_eff[];
};

layout(std430, binding = 8) readonly buffer BLENDED_COEFFICIENT        // The pre-evaluated values of F1 in the SST model
{
    float blended_coefficient[];
};


uint index_cell(uint x, uint y, uint z)
{
    return z * (grid_x * grid_y)
         + y * grid_x
         + x;
}


float harmonic_mean(float a, float b)
{
    return (2.0 * a * b) / (a + b);
}


void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x >= grid_x || y >= grid_y || z >= grid_z)
        return;

    // Boundary cells are handled by the wall treatment.
    if (x == 0u || x == grid_x - 1u ||
        y == 0u || y == grid_y - 1u ||
        z == 0u || z == grid_z - 1u)
        return;
    
    if(!is_omega_model)
        return;

    uint id = index_cell(x, y, z);

    float area_x = dy * dz;
    float area_y = dx * dz;
    float area_z = dx * dy;

    //constants
    float beta_star = 0.09;
    float sigma_k1 = 0.85;
    float sigma_k2 = 1.0;
    float sigma_omega1 = 0.5;
    float sigma_omega2 = 0.856;

    float F1 = blended_coefficient[id];
    //variable constant-like coefficients
    float sigma_k = (F1 * sigma_k1) + ((1.0 - F1) * sigma_k2);
    float sigma_omega = (F1 * sigma_omega1) + ((1.0 - F1) * sigma_omega2);


    // Neighbor indices
    uint id_W = index_cell(x - 1u, y, z);
    uint id_E = index_cell(x + 1u, y, z);

    uint id_N = index_cell(x, y - 1u, z);
    uint id_S = index_cell(x, y + 1u, z);

    uint id_T = index_cell(x, y, z - 1u);
    uint id_B = index_cell(x, y, z + 1u);

    float tao_P;
    float tao_face_E;
    float tao_face_W;
    float tao_face_S;
    float tao_face_N;
    float tao_face_B;
    float tao_face_T;

    // Harmonic face viscosities    
    // In k-omega model sigma_k = sigma_omega = 0.5 in our formulation wilcox 2002
    if(is_k)
    {
        tao_P = dynamic_viscosity + ((mu_eff[id] - dynamic_viscosity) * sigma_k);

        float tao_east_cell = dynamic_viscosity + ((mu_eff[id_E] - dynamic_viscosity) * sigma_k);
        float tao_west_cell = dynamic_viscosity + ((mu_eff[id_W] - dynamic_viscosity) * sigma_k);
        float tao_north_cell = dynamic_viscosity + ((mu_eff[id_N] - dynamic_viscosity) * sigma_k);
        float tao_south_cell = dynamic_viscosity + ((mu_eff[id_S] - dynamic_viscosity) * sigma_k);
        float tao_top_cell = dynamic_viscosity + ((mu_eff[id_T] - dynamic_viscosity) * sigma_k);
        float tao_bottom_cell = dynamic_viscosity + ((mu_eff[id_B] - dynamic_viscosity) * sigma_k);

        tao_face_E = harmonic_mean(tao_P, tao_east_cell);
        tao_face_W = harmonic_mean(tao_P, tao_west_cell);
        tao_face_N = harmonic_mean(tao_P, tao_north_cell);
        tao_face_S = harmonic_mean(tao_P, tao_south_cell);
        tao_face_B = harmonic_mean(tao_P, tao_bottom_cell);
        tao_face_T = harmonic_mean(tao_P, tao_top_cell);
    }
    else if(!is_k)
    {
        tao_P = dynamic_viscosity + ((mu_eff[id] - dynamic_viscosity) * sigma_omega);

        float tao_east_cell = dynamic_viscosity + ((mu_eff[id_E] - dynamic_viscosity) * sigma_omega);
        float tao_west_cell = dynamic_viscosity + ((mu_eff[id_W] - dynamic_viscosity) * sigma_omega);
        float tao_north_cell = dynamic_viscosity + ((mu_eff[id_N] - dynamic_viscosity) * sigma_omega);
        float tao_south_cell = dynamic_viscosity + ((mu_eff[id_S] - dynamic_viscosity) * sigma_omega);
        float tao_top_cell = dynamic_viscosity + ((mu_eff[id_T] - dynamic_viscosity) * sigma_omega);
        float tao_bottom_cell = dynamic_viscosity + ((mu_eff[id_B] - dynamic_viscosity) * sigma_omega);

        tao_face_E = harmonic_mean(tao_P, tao_east_cell);
        tao_face_W = harmonic_mean(tao_P, tao_west_cell);
        tao_face_N = harmonic_mean(tao_P, tao_north_cell);
        tao_face_S = harmonic_mean(tao_P, tao_south_cell);
        tao_face_B = harmonic_mean(tao_P, tao_bottom_cell);
        tao_face_T = harmonic_mean(tao_P, tao_top_cell);
    }

   
    // Diffusion conductances
    float D_E = tao_face_E * area_x / dx;
    float D_W = tao_face_W * area_x / dx;

    float D_S = tao_face_S * area_y / dy;
    float D_N = tao_face_N * area_y / dy;

    float D_B = tao_face_B * area_z / dz;
    float D_T = tao_face_T * area_z / dz;


    // Diffusion contribution
    aP[id] += D_E;
    aE[id] -= D_E;

    aP[id] += D_W;
    aW[id] -= D_W;

    aP[id] += D_S;
    aS[id] -= D_S;

    aP[id] += D_N;
    aN[id] -= D_N;

    aP[id] += D_B;
    aB[id] -= D_B;

    aP[id] += D_T;
    aT[id] -= D_T;
}