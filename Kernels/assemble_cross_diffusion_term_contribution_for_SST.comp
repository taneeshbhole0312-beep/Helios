#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;



layout(std430, binding = 0) buffer RHS_OMEGA
{
    float RHS_omega[];
};

layout(std430, binding = 1) buffer Omega
{
    float omega[];
};

layout(std430, binding = 2) buffer K
{
    float k[];
};

layout(std430, binding = 3) buffer F1_VALUES_FIELD
{
    float blended_coefficient[];
};

// diagonal of the omega system: the part of the cross diffusion that is treated implicitly is added here (Patankar, see the end of main)
layout(std430, binding = 4) buffer AP_OMEGA
{
    float aP[];
};

uniform int ap_only;            // 1: write only the aP increment, never the RHS (coarse multigrid levels: their RHS is a restricted residual, not a source)
uniform float density;
uniform uint grid_x;
uniform uint grid_y;
uniform uint grid_z;
uniform float dx;
uniform float dy;
uniform float dz;

const float sigma_omega_2 = 0.856;

uint index_cell(uint x, uint y, uint z)
{
    return z * (grid_x * grid_y)
         + y * grid_x
         + x;
}

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x >= grid_x || y >= grid_y || z >= grid_z)
        return;

    // Boundary cells are handled by the wall treatment.
    if (x == 0u || x == grid_x - 1u ||
        y == 0u || y == grid_y - 1u ||
        z == 0u || z == grid_z - 1u)
        return;


    uint index = index_cell(x, y, z);

    uint stride_x = 1;
    uint stride_y = grid_x;
    uint stride_z = grid_x * grid_y;

    vec3 grad_k;
    vec3 grad_omega;

    // X derivatives
    grad_k.x = (k[index + stride_x] -
                k[index - stride_x]) / (2.0 * dx);

    grad_omega.x = (omega[index + stride_x] -
                    omega[index - stride_x]) / (2.0 * dx);

    // Y derivatives
    grad_k.y = (k[index + stride_y] -
                k[index - stride_y]) / (2.0 * dy);

    grad_omega.y = (omega[index + stride_y] -
                    omega[index - stride_y]) / (2.0 * dy);

    // Z derivatives
    grad_k.z = (k[index + stride_z] -
                k[index - stride_z]) / (2.0 * dz);

    grad_omega.z = (omega[index + stride_z] -
                    omega[index - stride_z]) / (2.0 * dz);

    
    float dot_grad_k_grad_omega = (grad_k.x * grad_omega.x) + (grad_k.y * grad_omega.y) + (grad_k.z * grad_omega.z);

    // The 1e-12 is only a guard against dividing by exactly zero.
    float omega_value = max(omega[index], 1e-12);

    float CD_k_omega = (2.0 * density * sigma_omega_2 * (1.0 / omega_value) * dot_grad_k_grad_omega);
    
    float P_omega_CD = (1.0 - blended_coefficient[index]) * CD_k_omega;

    float volume = dx * dy * dz;

    // PATANKAR TREATMENT of the source S = P_omega_CD (per unit volume, evaluated from the previous iterate; S is proportional to 1 / omega).
    // The old explicit treatment put S * volume on the RHS whatever its sign; with omega ~ 0 that is a gain of 1 / omega in a lagged feedback loop
    // (omega -> grad(omega) -> S -> omega) and the loop diverges. Here the omega dependence of S is passed to the matrix instead:
    //
    //   S < 0 (sink)    S_eff = S * omega_new / omega_old                       adds  |S| volume / omega_old  to aP, nothing on the RHS
    //                   (proportional to the unknown, so omega_new = (...) / (aP + |S| volume / omega_old) cannot change sign)
    //   S > 0 (source)  S_eff = 2 S - (S / omega_old) * omega_new               adds  S volume / omega_old to aP and 2 S volume to the RHS
    //                   (first order Taylor expansion of 1 / omega around omega_old: the source falls as omega_new rises and is zero at omega_new = 2 omega_old,
    //                   so a cell can at most roughly double per nonlinear iteration instead of receiving S in one go)
    //
    // Both branches give exactly S when omega_new = omega_old, so the converged solution is the same as with the explicit treatment.
    // aP only ever increases, so diagonal dominance is never reduced.
    if (P_omega_CD < 0.0)
    {
        aP[index] += (-P_omega_CD) * volume / omega_value;
    }
    else
    {
        if (ap_only == 0)
            RHS_omega[index] += 2.0 * P_omega_CD * volume;

        aP[index] += P_omega_CD * volume / omega_value;
    }
}