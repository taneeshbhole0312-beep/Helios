#version 430 core

layout(local_size_x = 8,
       local_size_y = 8,
       local_size_z = 8) in;

layout(std430, binding = 0)
buffer vzBuffer
{
    float vz[];
};

layout(std430, binding = 1)
buffer writeonly vzOutBuffer
{
    float vz_out[];
};

uniform int cells_x;
uniform int cells_y;
uniform int cells_z;

uniform float dynamic_viscosity;
uniform float density;
uniform float stable_dt;
uniform float cell_side_x;
uniform float cell_side_y;
uniform float cell_side_z;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x >= cells_x || y >= cells_y || z > cells_z)
        return;

    uint idx = z * (cells_x * cells_y) + y * cells_x + x;

    float vz_west =
        (x > 0)
        ? vz[idx - 1]
        : vz[idx];

    float vz_east =
        (x < cells_x - 1)
        ? vz[idx + 1]
        : vz[idx];

    float vz_north =
        (y > 0)
        ? vz[idx - cells_x]
        : vz[idx];

    float vz_south =
        (y < cells_y - 1)
        ? vz[idx + cells_x]
        : vz[idx];

    float vz_top =
        (z > 0)
        ? vz[idx - (cells_x * cells_y)]
        : vz[idx];

    float vz_down =
        (z < cells_z)
        ? vz[idx + (cells_x * cells_y)]
        : vz[idx];

    float inv_dx2 = 1.0 / (cell_side_x * cell_side_x);
    float inv_dy2 = 1.0 / (cell_side_y * cell_side_y);
    float inv_dz2 = 1.0 / (cell_side_z * cell_side_z);

    float laplacian = (vz_west - 2.0 * vz[idx] + vz_east) * inv_dx2 + (vz_north - 2.0 * vz[idx] + vz_south) * inv_dy2 + (vz_top - 2.0 * vz[idx] + vz_down) * inv_dz2;

    float kinematic_viscosity = dynamic_viscosity / density;

   vz_out[idx] = vz[idx] + kinematic_viscosity * stable_dt * laplacian;
}