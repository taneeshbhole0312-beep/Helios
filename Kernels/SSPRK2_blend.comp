#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer OriginalV
{
    float vel0[];
};

layout(std430, binding = 1) buffer CurrentV
{
    float vel[];
};

uniform uint count;

void main()
{
    uint flatGroup = gl_WorkGroupID.z * (gl_NumWorkGroups.x * gl_NumWorkGroups.y)
                    + gl_WorkGroupID.y * gl_NumWorkGroups.x
                    + gl_WorkGroupID.x;

    uint i = flatGroup * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    if (i >= count)
        return;

    vel[i] = 0.5 * (vel0[i] + vel[i]);
}
