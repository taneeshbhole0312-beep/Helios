#version 430 core

layout(local_size_x = 8,
       local_size_y = 8,
       local_size_z = 8) in;

layout(std430, binding = 0)
buffer PressureBuf
{
    float pressure[];
};

layout(std430, binding = 1)
buffer MACHBuffer
{
    float MAC_h[];
};


uniform int cells_x;
uniform int cells_y;
uniform int cells_z;

uniform float cell_side_y;
uniform float stable_dt;
uniform float density;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    // vy grid: cells_x columns, (cells_y + 1) rows, cells_z layers
    if (x >= uint(cells_x) ||
        y >= uint(cells_y + 1) ||
        z >= uint(cells_z))
    {
        return;
    }

    uint h_idx = z * uint(cells_x * (cells_y + 1)) + y * uint(cells_x) + x;

    // this cell's pressure index (pressure cells are cells_x * cells_y * cells_z)
    uint p_idx = z * uint(cells_x * cells_y) + y * uint(cells_x) + x;

    float p_t;
    float p_b;

    if (y > 0u)
    {
        uint top_idx = p_idx - uint(cells_x);

        p_t = pressure[top_idx];
    }
    else
    {
        p_t = 0.0;
    }

    if (y < uint(cells_y))
    {
        uint bottom_idx = p_idx;

        p_b = pressure[bottom_idx];
    }
    else
    {
        p_b = 0.0;
    }

    float pressure_gradient_y = (p_b - p_t) / cell_side_y;

    MAC_h[h_idx] -= pressure_gradient_y * (stable_dt / density);

    if (y == 0u ||
        y == uint(cells_y))
    {
        MAC_h[h_idx] = 0.0;
    }

}
