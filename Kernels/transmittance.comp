#version 430 core

layout(local_size_x = 8,
       local_size_y = 8,
       local_size_z = 8) in;


// -----------------------------------------------------------------------------
// Density field
// -----------------------------------------------------------------------------

layout(std430, binding = 0)
buffer SamplingBuffer
{
    float sampling_field[];
};


// -----------------------------------------------------------------------------
// Light transmittance field
// -----------------------------------------------------------------------------

layout(std430, binding = 1)
buffer LightTransmittanceBuffer
{
    float light_transmittance[];
};


// -----------------------------------------------------------------------------
// Volume
// -----------------------------------------------------------------------------

uniform float volume_width;
uniform float volume_height;
uniform float volume_depth;

uniform int field_stride;
uniform int field_layer_stride;

uniform int field_x_elements;
uniform int field_y_elements;
uniform int field_z_elements;


// -----------------------------------------------------------------------------
// Light
// -----------------------------------------------------------------------------

uniform float light_x;
uniform float light_y;
uniform float light_z;

uniform float for_light_ds;

uniform float extinction_total;


// -----------------------------------------------------------------------------
// Field access
// -----------------------------------------------------------------------------

float fetchField(int x, int y, int z)
{
    x = clamp(x, 0, field_x_elements - 1);
    y = clamp(y, 0, field_y_elements - 1);
    z = clamp(z, 0, field_z_elements - 1);

    int idx =
        z * field_layer_stride +
        y * field_stride +
        x;

    return sampling_field[idx];
}


// -----------------------------------------------------------------------------
// Trilinear density sampling
// -----------------------------------------------------------------------------

float sampleTrilinear(vec3 worldPos)
{
    vec3 gridPos = vec3(
        (worldPos.x / volume_width)  * float(field_x_elements) - 0.5,
        (worldPos.y / volume_height) * float(field_y_elements) - 0.5,
        (worldPos.z / volume_depth)  * float(field_z_elements) - 0.5
    );

    gridPos = clamp(
        gridPos,
        vec3(0.0),
        vec3(
            float(field_x_elements - 1),
            float(field_y_elements - 1),
            float(field_z_elements - 1)
        )
    );

    ivec3 p0 = ivec3(floor(gridPos));

    ivec3 p1 = min(
        p0 + ivec3(1),
        ivec3(
            field_x_elements - 1,
            field_y_elements - 1,
            field_z_elements - 1
        )
    );

    vec3 f = fract(gridPos);

    float c000 = fetchField(p0.x, p0.y, p0.z);
    float c100 = fetchField(p1.x, p0.y, p0.z);
    float c010 = fetchField(p0.x, p1.y, p0.z);
    float c110 = fetchField(p1.x, p1.y, p0.z);

    float c001 = fetchField(p0.x, p0.y, p1.z);
    float c101 = fetchField(p1.x, p0.y, p1.z);
    float c011 = fetchField(p0.x, p1.y, p1.z);
    float c111 = fetchField(p1.x, p1.y, p1.z);

    float c00 = mix(c000, c100, f.x);
    float c10 = mix(c010, c110, f.x);

    float c01 = mix(c001, c101, f.x);
    float c11 = mix(c011, c111, f.x);

    float c0 = mix(c00, c10, f.y);
    float c1 = mix(c01, c11, f.y);

    return mix(c0, c1, f.z);
}


// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------

void main()
{
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;
    uint gz = gl_GlobalInvocationID.z;

    if (gx >= uint(field_x_elements) ||
        gy >= uint(field_y_elements) ||
        gz >= uint(field_z_elements))
    {
        return;
    }


    // -------------------------------------------------------------------------
    // Cell center
    // -------------------------------------------------------------------------

    vec3 cellSize = vec3(
        volume_width  / float(field_x_elements),
        volume_height / float(field_y_elements),
        volume_depth  / float(field_z_elements)
    );

    vec3 samplePosition = (vec3(gx, gy, gz) + vec3(0.5)) * cellSize;


    // -------------------------------------------------------------------------
    // Direction from cell -> light
    // -------------------------------------------------------------------------

    vec3 lightPosition = vec3(light_x, light_y, light_z);

    vec3 toLight = lightPosition - samplePosition;

    float lightDistance = length(toLight);


    // Cell is effectively at the light
    if (lightDistance < 1e-6)
    {
        int idx = int(gz) * field_layer_stride + int(gy) * field_stride + int(gx);

        light_transmittance[idx] = 1.0;
        return;
    }

    vec3 lightDir = toLight / lightDistance;


    // -------------------------------------------------------------------------
    // Invalid light kadam protection
    // -------------------------------------------------------------------------

    int outputIdx = int(gz) * field_layer_stride + int(gy) * field_stride + int(gx);

    if (for_light_ds <= 0.0)
    {
        light_transmittance[outputIdx] = 0.0;
        return;
    }


    // -------------------------------------------------------------------------
    // Integrate optical depth from this cell toward the light.
    //
    // Midpoint sampling:
    //
    //     sample position = start + (t + ds/2) * direction
    //
    // -------------------------------------------------------------------------

    float optical_depth = 0.0;

    float t = 0.0;

    while (t < lightDistance)
    {
        float kadam = min(for_light_ds, lightDistance - t);

        float sample_t = t + 0.5 * kadam;

        vec3 lightSamplePosition = samplePosition + sample_t * lightDir;

        // -------------------------------------------------------------
        // If the light ray leaves the volume before reaching the light,
        // stop integrating. Outside the volume there is no smoke.
        // -------------------------------------------------------------

        if (lightSamplePosition.x < 0.0 ||
            lightSamplePosition.x > volume_width ||
            lightSamplePosition.y < 0.0 ||
            lightSamplePosition.y > volume_height ||
            lightSamplePosition.z < 0.0 ||
            lightSamplePosition.z > volume_depth)
        {
            break;
        }

        float density = sampleTrilinear(lightSamplePosition);


        float sigma_total = density * extinction_total;


        optical_depth += sigma_total * kadam;


        // -------------------------------------------------------------
        // Once essentially no light remains, stop.
        // -------------------------------------------------------------

        if (optical_depth > 20.0)
        {
            optical_depth = 20.0;
            break;
        }


        t += kadam;
    }


    // -------------------------------------------------------------------------
    // Beer-Lambert
    // -------------------------------------------------------------------------

    float transmittance = exp(-optical_depth);


    light_transmittance[outputIdx] = transmittance;
}