#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

// ============================================================
// Visualises ANY field living in an SSBO, on one z-slice.
//
// The field is normalised INSIDE this kernel by the global maximum magnitude (max |field|) that the existing
// CFL_reduction kernel left in element 0 of `max_magnitude`. Nothing normalised is ever stored: the only output is
// the colour written to the image.
//
// Magnitudes are used throughout (sign is discarded), so a field that is mostly negative is normalised and
// coloured exactly like its mirror image.
// ============================================================

layout(rgba32f, binding = 0)
uniform image2D outputImage;

// the field to show: cell centred, or one MAC face component (see `topology`)
layout(std430, binding = 1)
buffer FieldBuffer
{
    float field[];
};

// element 0 = max |field| over the whole field (result of the CFL_reduction chain)
layout(std430, binding = 2)
buffer MaxMagnitudeBuffer
{
    float max_magnitude[];
};

uniform int image_width;
uniform int image_height;

// pressure-cell grid
uniform int cells_x;
uniform int cells_y;
uniform int cells_z;

// 0 = CELL_CENTERED, 1 = XFACE_CENTERED (u), 2 = YFACE_CENTERED (v), 3 = ZFACE_CENTERED (w)
uniform int topology;

uniform int slice_id;


// |field| at one of the cell's own sample points, using the field's real DOF layout
float magnitude_cell_value(int x, int y, int z)
{
    if (topology == 1)           // (cells_x + 1) x cells_y x cells_z
    {
        int idx = z * ((cells_x + 1) * cells_y) + y * (cells_x + 1) + x;
        return 0.5 * (abs(field[idx]) + abs(field[idx + 1]));
    }
    else if (topology == 2)      // cells_x x (cells_y + 1) x cells_z
    {
        int idx = z * (cells_x * (cells_y + 1)) + y * cells_x + x;
        return 0.5 * (abs(field[idx]) + abs(field[idx + cells_x]));
    }
    else if (topology == 3)      // cells_x x cells_y x (cells_z + 1)
    {
        int idx = z * (cells_x * cells_y) + y * cells_x + x;
        return 0.5 * (abs(field[idx]) + abs(field[idx + cells_x * cells_y]));
    }

    int idx = z * (cells_x * cells_y) + y * cells_x + x;
    return abs(field[idx]);
}

// dark blue -> cyan -> green -> yellow -> red
vec3 heat_map(float t)
{
    t = clamp(t, 0.0, 1.0);

    const vec3 c0 = vec3(0.02, 0.02, 0.30);
    const vec3 c1 = vec3(0.00, 0.75, 0.95);
    const vec3 c2 = vec3(0.10, 0.85, 0.20);
    const vec3 c3 = vec3(0.98, 0.90, 0.10);
    const vec3 c4 = vec3(0.90, 0.05, 0.05);

    if (t < 0.25) return mix(c0, c1, t / 0.25);
    if (t < 0.50) return mix(c1, c2, (t - 0.25) / 0.25);
    if (t < 0.75) return mix(c2, c3, (t - 0.50) / 0.25);
    return mix(c3, c4, (t - 0.75) / 0.25);
}


void main()
{
    int px = int(gl_GlobalInvocationID.x);
    int py = int(gl_GlobalInvocationID.y);

    if (px >= image_width || py >= image_height)
        return;

    // same convention as ray_march.comp: image row 0 is the top row of the picture
    int cx = clamp(int((float(px) + 0.5) / float(image_width)  * float(cells_x)), 0, cells_x - 1);
    int cy = clamp(int((float(py) + 0.5) / float(image_height) * float(cells_y)), 0, cells_y - 1);
    int cz = clamp(slice_id, 0, cells_z - 1);

    float m = max_magnitude[0];

    float normalised = 0.0;

    if (m > 0.0)
        normalised = clamp(magnitude_cell_value(cx, cy, cz) / m, 0.0, 1.0);

    // alpha 1: fragment.frag then shows the colour as is
    imageStore(outputImage, ivec2(px, py), vec4(heat_map(normalised), 1.0));
}
