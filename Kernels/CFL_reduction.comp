#version 430 core

layout(local_size_x = 256) in;

// One scalar velocity field.
// This can be:
// - particle speeds, if you already packed them into one array
// - MAC face vx values
// - MAC face vy values
layout(std430, binding = 0)
buffer VelocityBuffer
{
    float velocity[];
};

// One float per workgroup.
// Each workgroup writes its own maximum here.
layout(std430, binding = 1)
buffer OutputBuffer
{
    float groupMax[];
};

uniform uint elements_count;

// Number of workgroups the CPU actually needs (== groupMax's length). The dispatch
// itself is padded up to a rectangular x*y*z grid because GL_MAX_COMPUTE_WORK_GROUP_COUNT
// is only guaranteed to be 65535 per axis; this discards the padded extra groups before
// they write past the end of groupMax.
uniform uint total_groups;

shared float localMax[256];

void main()
{
    // Fold the 3D dispatch grid back into one flat, contiguous group index.
    uint flatGroup = gl_WorkGroupID.z * (gl_NumWorkGroups.x * gl_NumWorkGroups.y)
                    + gl_WorkGroupID.y * gl_NumWorkGroups.x
                    + gl_WorkGroupID.x;

    if (flatGroup >= total_groups)
        return;

    uint idx = flatGroup * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;

    // Default to zero for threads past the end of the array.
    float value = 0.0f;

    if (idx < elements_count)
    {
        // Use absolute value because CFL only cares about speed.
        value = abs(velocity[idx]);
    }

    // Store one value per thread in shared memory.
    localMax[lid] = value;

    // Make sure all threads wrote their value before reduction starts.
    barrier();

    // Parallel reduction: 256 -> 128 -> 64 -> ... -> 1
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (lid < stride)
        {
            localMax[lid] = max(localMax[lid], localMax[lid + stride]);
        }

        barrier();
    }

    // Thread 0 writes the workgroup maximum to global memory.
    if (lid == 0u)
    {
        groupMax[flatGroup] = localMax[0];
    }
}
