#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) 
uniform image2D outputImage;

layout(std430, binding = 1)
buffer SamplingBuffer
{
    float sampling_field[];
};

layout(std430, binding = 2)
buffer TransmittanceBuffer
{
    float transmittance_field[];
};

uniform int image_height;
uniform int image_width;
uniform float halfWidth;
uniform float halfHeight;
uniform vec3 cameraPosition;
uniform vec3 cameraForward;
uniform vec3 cameraRight;
uniform vec3 cameraUp;

uniform float volume_width;
uniform float volume_height;
uniform float volume_depth;
uniform float ds;
uniform float for_light_ds;

uniform int field_stride;
uniform int field_layer_stride;
uniform int field_x_elements;
uniform int field_y_elements;
uniform int field_z_elements;
uniform float light_x;
uniform float light_y;
uniform float light_z;
uniform float light_intensity;
uniform float extinction_via_scattering;
uniform float extinction_total;
uniform float mean_cosine;

float fetchField(int x, int y, int z)
{
    x = clamp(x, 0, field_x_elements - 1);
    y = clamp(y, 0, field_y_elements - 1);
    z = clamp(z, 0, field_z_elements - 1);

    int idx = z * field_layer_stride + y * field_stride + x;
    return sampling_field[idx];
}

float fetchTransmittance(int x, int y, int z)
{
    x = clamp(x, 0, field_x_elements - 1);
    y = clamp(y, 0, field_y_elements - 1);
    z = clamp(z, 0, field_z_elements - 1);

    int idx = z * field_layer_stride + y * field_stride + x;
    return transmittance_field[idx];
}

float sampleTrilinear(vec3 worldPos)
{
    // Assumes the volume starts at (0,0,0) and spans
    // (volume_width, volume_height, volume_depth)
    vec3 gridPos = vec3(
        (worldPos.x / volume_width)  * float(field_x_elements) - 0.5,
        (worldPos.y / volume_height) * float(field_y_elements) - 0.5,
        (worldPos.z / volume_depth)  * float(field_z_elements) - 0.5
    );

    // Clamp so floor + 1 stays valid
    gridPos = clamp(
        gridPos,
        vec3(0.0),
        vec3(
            float(field_x_elements - 1),
            float(field_y_elements - 1),
            float(field_z_elements - 1)
        )
    );

    ivec3 p0 = ivec3(floor(gridPos));
    ivec3 p1 = min(p0 + ivec3(1), ivec3(field_x_elements - 1, field_y_elements - 1, field_z_elements - 1));

    vec3 f = fract(gridPos);

    float c000 = fetchField(p0.x, p0.y, p0.z);
    float c100 = fetchField(p1.x, p0.y, p0.z);
    float c010 = fetchField(p0.x, p1.y, p0.z);
    float c110 = fetchField(p1.x, p1.y, p0.z);

    float c001 = fetchField(p0.x, p0.y, p1.z);
    float c101 = fetchField(p1.x, p0.y, p1.z);
    float c011 = fetchField(p0.x, p1.y, p1.z);
    float c111 = fetchField(p1.x, p1.y, p1.z);

    float c00 = mix(c000, c100, f.x);
    float c10 = mix(c010, c110, f.x);
    float c01 = mix(c001, c101, f.x);
    float c11 = mix(c011, c111, f.x);

    float c0 = mix(c00, c10, f.y);
    float c1 = mix(c01, c11, f.y);

    return mix(c0, c1, f.z);
}

float sampleTrilinearTransmittance(vec3 worldPos)
{
    // Assumes the volume starts at (0,0,0) and spans
    // (volume_width, volume_height, volume_depth)
    vec3 gridPos = vec3(
        (worldPos.x / volume_width)  * float(field_x_elements) - 0.5,
        (worldPos.y / volume_height) * float(field_y_elements) - 0.5,
        (worldPos.z / volume_depth)  * float(field_z_elements) - 0.5
    );

    // Clamp so floor + 1 stays valid
    gridPos = clamp(
        gridPos,
        vec3(0.0),
        vec3(
            float(field_x_elements - 1),
            float(field_y_elements - 1),
            float(field_z_elements - 1)
        )
    );

    ivec3 p0 = ivec3(floor(gridPos));
    ivec3 p1 = min(p0 + ivec3(1), ivec3(field_x_elements - 1, field_y_elements - 1, field_z_elements - 1));

    vec3 f = fract(gridPos);

    float c000 = fetchTransmittance(p0.x, p0.y, p0.z);
    float c100 = fetchTransmittance(p1.x, p0.y, p0.z);
    float c010 = fetchTransmittance(p0.x, p1.y, p0.z);
    float c110 = fetchTransmittance(p1.x, p1.y, p0.z);

    float c001 = fetchTransmittance(p0.x, p0.y, p1.z);
    float c101 = fetchTransmittance(p1.x, p0.y, p1.z);
    float c011 = fetchTransmittance(p0.x, p1.y, p1.z);
    float c111 = fetchTransmittance(p1.x, p1.y, p1.z);

    float c00 = mix(c000, c100, f.x);
    float c10 = mix(c010, c110, f.x);
    float c01 = mix(c001, c101, f.x);
    float c11 = mix(c011, c111, f.x);

    float c0 = mix(c00, c10, f.y);
    float c1 = mix(c01, c11, f.y);

    return mix(c0, c1, f.z);
}

uniform float smoke_color_min;
uniform float smoke_color_max;

vec3 smokeColorMap(float value)
{
    float range = max(smoke_color_max - smoke_color_min, 1e-8);

    float x = clamp(
        (value - smoke_color_min) / range,
        0.0,
        1.0
    );

    if (x < 0.25)
    {
        return mix(
            vec3(0.157, 0.141, 0.655),
            vec3(0.129, 0.522, 0.816),
            x / 0.25
        );
    }
    else if (x < 0.50)
    {
        return mix(
            vec3(0.129, 0.522, 0.816),
            vec3(0.133, 0.749, 0.631),
            (x - 0.25) / 0.25
        );
    }
    else if (x < 0.75)
    {
        return mix(
            vec3(0.133, 0.749, 0.631),
            vec3(0.902, 0.847, 0.290),
            (x - 0.50) / 0.25
        );
    }

    return mix(
        vec3(0.902, 0.847, 0.290),
        vec3(0.906, 0.227, 0.192),
        (x - 0.75) / 0.25
    );
}

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= uint(image_width) || y >= uint(image_height))
        return;

    float normalized_x = (float(x) + 0.5) / image_width;
    float normalized_y = (float(y) + 0.5) / image_height;

    float standard_x = (2 * normalized_x) - 1;
    float standard_y = 1 - (2 * normalized_y);

    standard_x *= halfWidth;
    standard_y *= halfHeight;

    vec3 image_point = cameraForward + standard_x * cameraRight + standard_y * cameraUp;

    float len = length(image_point);

    vec3 ray_dir = image_point / len;
    vec3 origin = cameraPosition;

    
    const float EPS = 1e-8;
    const float INF = 1e30;

    float tx_min, tx_max;
    float ty_min, ty_max;
    float tz_min, tz_max;

    // --------------------------------------------------
    // X slab
    // --------------------------------------------------

    if (abs(ray_dir.x) < EPS)
    {
        // Ray is parallel to the X-axis planes.
        // Therefore it can only intersect the box if
        // its X position is already inside the X slab.

        if (origin.x < 0.0 || origin.x > volume_width)
        {
            imageStore(outputImage, ivec2(x, y), vec4(0.0));
            return;
        }

        tx_min = -INF; // -infinity
        tx_max = INF; // +infinity
    }
    else
    {
        float tx0 = (0.0 - origin.x) / ray_dir.x;
        float tx1 = (volume_width - origin.x) / ray_dir.x;

        tx_min = min(tx0, tx1);
        tx_max = max(tx0, tx1);
    }


    // --------------------------------------------------
    // Y slab
    // --------------------------------------------------

    if (abs(ray_dir.y) < EPS)
    {
        // Ray is parallel to the Y-axis planes.

        if (origin.y < 0.0 || origin.y > volume_height)
        {
            imageStore(outputImage, ivec2(x, y), vec4(1.0, 0.0, 0.0, 0.598));
            return;
        }

        ty_min = -INF; // -infinity
        ty_max =  INF; // +infinity
    }
    else
    {
        float ty0 = (0.0 - origin.y) / ray_dir.y;
        float ty1 = (volume_height - origin.y) / ray_dir.y;

        ty_min = min(ty0, ty1);
        ty_max = max(ty0, ty1);
    }


    // --------------------------------------------------
    // Z slab
    // --------------------------------------------------

    if (abs(ray_dir.z) < EPS)
    {
        // Ray is parallel to the Z-axis planes.

        if (origin.z < 0.0 || origin.z > volume_depth)
        {
            imageStore(outputImage, ivec2(x, y), vec4(0.0));
            return;
        }

        tz_min = -INF; // -infinity
        tz_max =  INF; // +infinity
    }
    else
    {
        float tz0 = (0.0 - origin.z) / ray_dir.z;
        float tz1 = (volume_depth - origin.z) / ray_dir.z;

        tz_min = min(tz0, tz1);
        tz_max = max(tz0, tz1);
    }


    // --------------------------------------------------
    // Combine the three slabs
    // --------------------------------------------------

    float t_entry = max(max(tx_min, ty_min), tz_min);
    float t_exit  = min(min(tx_max, ty_max), tz_max);


    // --------------------------------------------------
    // Reject rays that don't produce a visible segment
    // --------------------------------------------------

    if (t_entry > t_exit || t_exit < 0.0)
    {
        imageStore(outputImage, ivec2(x, y), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    t_entry = max(t_entry, 0.0);

    vec3 accumulatedRadiance = vec3(0.0);
    float camera_optical_depth = 0.0;
    vec3 lightPosition = vec3(light_x, light_y, light_z);

    for (float t = t_entry; t < t_exit;)
    {
        float kadam = min(ds, t_exit - t);

        vec3 samplePosition = origin + t * ray_dir;

        float sampled_value = sampleTrilinear(samplePosition);
        vec3 sampleColor = smokeColorMap(sampled_value);

        float sigma_total = sampled_value * extinction_total;     
        float sigma_scattering = sampled_value * extinction_via_scattering;  

        float camera_transistance = exp(-camera_optical_depth);

        //Light's information
        vec3 toLight = lightPosition - samplePosition;     //displacement

        float lightDistance = length(toLight);

        if (lightDistance < 1e-6)
            lightDistance = 1e-6;

        vec3 lightDir = toLight / lightDistance;    //If you ever want to make a EXTREMELY LIKE RIDICULOUSLY high quality simulation, just evealuate the transmittance at every sample point of the camera ray instead of relying on this pre-computed methods. That is, run a loop (launch a ray to the light)

        // Find the transmittance
        float light_transmittance = sampleTrilinearTransmittance(samplePosition);

        // scatter probability (Henyey Greenstein)
        float input_cosine = dot(lightDir, ray_dir);

        float numerator = 1 - (mean_cosine * mean_cosine); // Henyey greenstein

        float denominator = (4 * 3.1415926536) * pow((1 + (mean_cosine * mean_cosine) - 2 * mean_cosine * input_cosine), 1.5); // Henyey greenstein

        float scatter_fractional_part = numerator / denominator;

        float lightFalloff = light_intensity / max(lightDistance * lightDistance, EPS);

        float delta_radiance =
            camera_transistance *
            lightFalloff *
            light_transmittance *
            sigma_scattering *
            scatter_fractional_part *
            kadam;

        accumulatedRadiance += sampleColor * delta_radiance;

        camera_optical_depth += sigma_total * kadam;
        float newTransmittance = exp(-camera_optical_depth);

        if (newTransmittance <= 0.01)
            break;

        t += kadam;
    }

    vec3 color = accumulatedRadiance;
    
    float finalOpacity = 1.0 - exp(-camera_optical_depth);

    imageStore(
        outputImage,
        ivec2(x, y),
        vec4(color, finalOpacity)
    );

}