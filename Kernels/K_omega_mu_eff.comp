#version 430 core

layout( local_size_x = 8,
        local_size_y = 8,
        local_size_z = 8) in;


// ============================================================
// mu_t = rho * (k / omega)
// mu_eff = mu_t + dynamic_viscosity
// ============================================================

// Cell-centered grid dimensions
uniform uint grid_x;
uniform uint grid_y;
uniform uint grid_z;

// Fluid properties
uniform float dynamic_viscosity;
uniform float density;


// Cell-centered k
layout(std430, binding = 0) readonly buffer KField
{
    float k[];
};

// Cell-centered epsilon
layout(std430, binding = 1) readonly buffer OmegaField
{
    float omega[];
};

// Cell-centered effective viscosity (output)
layout(std430, binding = 2) writeonly buffer EffectiveViscosity
{
    float mu_eff[];
};


uint index_cell(uint x, uint y, uint z)
{
    return z * (grid_x * grid_y)
         + y * grid_x
         + x;
}


void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x >= grid_x || y >= grid_y || z >= grid_z)
        return;

    uint id = index_cell(x, y, z);

    bool wall_x_min = (x == 0u);
    bool wall_x_max = (x == grid_x - 1u);

    bool wall_y_min = (y == 0u);
    bool wall_y_max = (y == grid_y - 1u);

    bool wall_z_min = (z == 0u);
    bool wall_z_max = (z == grid_z - 1u);

    bool is_wall_cell =
        wall_x_min || wall_x_max ||
        wall_y_min || wall_y_max ||
        wall_z_min || wall_z_max;

    if(is_wall_cell)
        return;

    // A negative k would still give a positive k^2, so it is clipped to zero (mu_t = 0) rather than squared.
    float k_positive = max(k[id], 0.0);

    // Same FLT_MIN guard as the eps source kernel: k = eps = 0 gives mu_t = 0 instead of 0 / 0.
    float omega_safe = max(omega[id], 0.0) + 1.17549435e-38;

    float mu_t = density * k_positive / omega_safe;

    mu_eff[id] = dynamic_viscosity + mu_t;
}
