//residual has to be summed not averaged, so there is a distinction made here for physical fields restriction program and residual restriction program
//
//=================================================================================================================================
// RESIDUAL RESTRICTION (GENERIC MULTIGRID), geometric overlap based, any fine / coarse ratio
//
// The RANS systems are volume-integrated (every row is the balance over its control volume: aP holds rho V / dt, ...), so the
// residual R_f of a fine DOF is an INTEGRATED quantity over its control volume. The coarse RHS is the integral over the coarse
// control volume, i.e. every fine residual contributes the fraction of its control volume that lies inside the coarse one:
//
//      R_c = sum_f ( V_overlap / V_f ) R_f
//
// Lengths are measured in units of ONE FINE CELL, so V_overlap / V_f is just l_x * l_y * l_z (each l in [0, 1]).
// Every fine control volume is covered completely by coarse ones, so sum_c ( V_overlap / V_f ) = 1: the integrated residual is
// conserved (apart from what falls on the Dirichlet rows, see below).
//
// Control volumes in fine-cell units (ratio r = fine cells / coarse cells along that axis):
//      cell axis   : coarse cell I = [ I r, (I + 1) r ),  fine cell i = [ i, i + 1 )
//      normal axis : coarse face I = [ (I - 1/2) r, (I + 1/2) r ),  fine face i = [ i - 1/2, i + 1/2 )
//                    (shifted by + 1/2 below so that the fine face i also becomes [ i, i + 1 ))
// For an exact 2:1 ratio this is plain summation of the 2 x 2 x 2 children for a cell field and the standard staggered
// "1/2, 1, 1/2" full weighting along the normal axis of a face field.
//
// Wall-normal DOFs (u at x = 0 / L, v at y = 0 / L, w at z = 0 / L) are Dirichlet rows (u = 0) on every level, so their coarse
// residual is set to 0: the coarse correction there must be exactly 0.
//=================================================================================================================================

#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Fine-grid field
layout(std430, binding = 0) readonly buffer FineField
{
    float fineField[];
};

// Coarse-grid field
layout(std430, binding = 1) writeonly buffer CoarseField
{
    float coarseField[];
};

// Number of elements (DOFs) in each dimension
uniform ivec3 fineDimensions;
uniform ivec3 coarseDimensions;

// 0 = CELL_CENTERED
// 1 = XFACE_CENTERED
// 2 = YFACE_CENTERED
// 3 = ZFACE_CENTERED
uniform int topology;


// ------------------------------------------------------------
// Flatten 3D index
// ------------------------------------------------------------
uint index3D(ivec3 p, ivec3 dimensions)
{
    return uint(
        p.x +
        p.y * dimensions.x +
        p.z * dimensions.x * dimensions.y
    );
}

// Cell counts of a level: a face-centered field has one more DOF than cells along its normal axis
ivec3 cellCounts(ivec3 dimensions)
{
    ivec3 cells = dimensions;

    if (topology == 1) cells.x -= 1;
    else if (topology == 2) cells.y -= 1;
    else if (topology == 3) cells.z -= 1;

    return cells;
}

// A position in fine-cell units = numerator / denominator, kept as an exact whole part plus a fraction in [0, 1).
// Overlaps are then computed from small local numbers, so their precision does not degrade far from the origin, and a boundary
// shared by two coarse neighbours (or the domain end) is bit-identical from both sides.
struct Coordinate
{
    int whole;
    float frac;
};

Coordinate makeCoordinate(int numerator, int denominator)        // numerator >= 0, denominator > 0
{
    Coordinate c;
    c.whole = numerator / denominator;
    c.frac = float(numerator - c.whole * denominator) / float(denominator);
    return c;
}

// Length of [lo, hi) inside the fine control volume [i, i + 1)
float overlap(Coordinate lo, Coordinate hi, int i)
{
    float lo_local = float(lo.whole - i) + lo.frac;
    float hi_local = float(hi.whole - i) + hi.frac;

    return max(0.0, min(hi_local, 1.0) - max(lo_local, 0.0));
}


void main()
{
    ivec3 coarseID = ivec3(gl_GlobalInvocationID.xyz);

    // Don't process threads outside the coarse field.
    if (coarseID.x >= coarseDimensions.x ||
        coarseID.y >= coarseDimensions.y ||
        coarseID.z >= coarseDimensions.z)
    {
        return;
    }

    uint coarseIndex = index3D(coarseID, coarseDimensions);

    int normal_axis = topology - 1;         // -1 for a cell-centered field

    // Dirichlet (wall-normal) rows: homogeneous correction
    if (normal_axis >= 0 &&
        (coarseID[normal_axis] == 0 || coarseID[normal_axis] == coarseDimensions[normal_axis] - 1))
    {
        coarseField[coarseIndex] = 0.0;
        return;
    }

    ivec3 fineCells = cellCounts(fineDimensions);
    ivec3 coarseCells = cellCounts(coarseDimensions);

    // coarse control volume [lo, hi) in fine-cell units (denominator 2 * coarse cells), and the fine DOF range it can touch
    Coordinate lo[3];
    Coordinate hi[3];
    ivec3 first;
    ivec3 last;

    for (int axis = 0; axis < 3; axis++)
    {
        int I = coarseID[axis];
        int Nf = fineCells[axis];
        int Nc = coarseCells[axis];

        if (axis == normal_axis)
        {
            // (I -/+ 1/2) r + 1/2   (I >= 1 here, the Dirichlet faces returned above)
            // in order to make the same overlap function work, we shift the coarse cells by half fine cell widths
            lo[axis] = makeCoordinate((2 * I - 1) * Nf + Nc, 2 * Nc);   
            hi[axis] = makeCoordinate((2 * I + 1) * Nf + Nc, 2 * Nc);  
        }
        else
        {
            // I r  and  (I + 1) r
            lo[axis] = makeCoordinate(I * Nf, Nc);
            hi[axis] = makeCoordinate((I + 1) * Nf, Nc);
        }

        first[axis] = max(lo[axis].whole, 0);
        last[axis]  = min((hi[axis].frac > 0.0) ? hi[axis].whole : hi[axis].whole - 1, fineDimensions[axis] - 1);    // ceil(hi) - 1
    }

    float sum = 0.0;

    for (int k = first.z; k <= last.z; ++k)
    {
        float wz = overlap(lo[2], hi[2], k);

        for (int j = first.y; j <= last.y; ++j)
        {
            float wy = overlap(lo[1], hi[1], j);

            for (int i = first.x; i <= last.x; ++i)
            {
                float w = overlap(lo[0], hi[0], i) * wy * wz;

                if (w > 0.0)
                    sum += w * fineField[index3D(ivec3(i, j, k), fineDimensions)];
            }
        }
    }

    coarseField[coarseIndex] = sum;
}
