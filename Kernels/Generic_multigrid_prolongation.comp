#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;


// ------------------------------------------------------------
// Coarse-grid correction
// ------------------------------------------------------------

layout(std430, binding = 0) readonly buffer CoarseCorrection
{
    float coarseCorrection[];
};


// ------------------------------------------------------------
// Fine-grid correction
//
// IMPORTANT:
// We ADD the interpolated correction rather than overwriting
// the existing fine correction.
// ------------------------------------------------------------

layout(std430, binding = 1) buffer FineCorrection
{
    float fineCorrection[];
};


// ------------------------------------------------------------
// Fine-grid dimensions
//
// These are the ACTUAL DOF dimensions of the fine field.
//
// Examples:
//
// CELL:
//     Nx × Ny × Nz
//
// XFACE:
//     (Nx+1) × Ny × Nz
//
// YFACE:
//     Nx × (Ny+1) × Nz
//
// ZFACE:
//     Nx × Ny × (Nz+1)
// ------------------------------------------------------------

uniform ivec3 fineDimensions;


// ------------------------------------------------------------
// Coarse-grid dimensions
// ------------------------------------------------------------

uniform ivec3 coarseDimensions;


// ------------------------------------------------------------
// Topology
//
// 0 = CELL_CENTERED
// 1 = XFACE_CENTERED
// 2 = YFACE_CENTERED
// 3 = ZFACE_CENTERED
// ------------------------------------------------------------

uniform int topology;


// ------------------------------------------------------------
// Flatten a 3D coordinate.
//
// Layout:
//
// index = x
//       + y * Nx
//       + z * Nx * Ny
// ------------------------------------------------------------

uint index3D(ivec3 p, ivec3 dimensions)
{
    return uint(
        p.x +
        p.y * dimensions.x +
        p.z * dimensions.x * dimensions.y
    );
}


// ------------------------------------------------------------
// Cell counts of a level: a face-centered field has one more
// DOF than cells along its normal axis.
// ------------------------------------------------------------

ivec3 cellCounts(ivec3 dimensions)
{
    ivec3 cells = dimensions;

    if (topology == 1) cells.x -= 1;
    else if (topology == 2) cells.y -= 1;
    else if (topology == 3) cells.z -= 1;

    return cells;
}


void main()
{
    // --------------------------------------------------------
    // One invocation = one fine-grid DOF
    // --------------------------------------------------------

    ivec3 fineID = ivec3(gl_GlobalInvocationID.xyz);

    if (fineID.x >= fineDimensions.x ||
        fineID.y >= fineDimensions.y ||
        fineID.z >= fineDimensions.z)
    {
        return;
    }


    // --------------------------------------------------------
    // Determine the location of the fine DOF in coarse-grid
    // index space.
    //
    // Both grids span the same physical domain, so along each axis
    //
    //     coarse coordinate = fine coordinate * (coarse cells / fine cells)
    //
    // (any ratio, e.g. 62 / 125), accounting for the half-cell
    // offsets associated with cell-centered and face-centered
    // topologies.
    // --------------------------------------------------------

    vec3 fineOffset;
    vec3 coarseOffset;


    if (topology == 0)
    {
        // CELL CENTERED
        //
        // Fine cell center:
        //
        //     i + 0.5
        //
        // Coarse cell center:
        //
        //     I + 0.5

        fineOffset   = vec3(0.5);
        coarseOffset = vec3(0.5);
    }
    else if (topology == 1)
    {
        // X FACE CENTERED
        //
        // x is face-centered:
        //     i
        //
        // y,z are cell-centered:
        //     j + 0.5
        //     k + 0.5

        fineOffset   = vec3(0.0, 0.5, 0.5);
        coarseOffset = vec3(0.0, 0.5, 0.5);
    }
    else if (topology == 2)
    {
        // Y FACE CENTERED
        fineOffset   = vec3(0.5, 0.0, 0.5);
        coarseOffset = vec3(0.5, 0.0, 0.5);
    }
    else
    {
        // Z FACE CENTERED
        fineOffset   = vec3(0.5, 0.5, 0.0);
        coarseOffset = vec3(0.5, 0.5, 0.0);
    }


    // --------------------------------------------------------
    // Physical-coordinate position of this fine DOF, expressed
    // in units of the fine-grid spacing.
    // --------------------------------------------------------

    // (kept as twice the position, an integer, see below)
    ivec3 twiceFinePosition = 2 * fineID + ivec3(2.0 * fineOffset);


    // --------------------------------------------------------
    // Convert the physical position into coarse-grid index
    // space.
    //
    // Coarse spacing = fine spacing * (fine cells / coarse cells)
    // per axis: the true spacings domain / cells of each level.
    // Subtract coarseOffset so that the resulting coordinate
    // is measured relative to coarse DOF indices.
    //
    // The coordinate is the exact rational
    //     (twiceFinePosition * Nc - 2 * coarseOffset * Nf) / (2 Nf)
    // evaluated on integers: its floor (the lower coarse index)
    // is exact and the weight t is the remainder, so the
    // precision does not depend on how far the DOF is from the
    // origin, and an exact ratio (e.g. 2:1) gives exactly the
    // old positions.
    // --------------------------------------------------------

    ivec3 fineCells = cellCounts(fineDimensions);
    ivec3 coarseCells = cellCounts(coarseDimensions);

    ivec3 numerator = twiceFinePosition * coarseCells - ivec3(2.0 * coarseOffset) * fineCells;
    ivec3 denominator = 2 * fineCells;


    // --------------------------------------------------------
    // Lower coarse-grid index (floor division: the numerator is
    // negative for the first half cell next to a boundary).
    // --------------------------------------------------------

    ivec3 coarseBase;

    for (int axis = 0; axis < 3; axis++)
    {
        coarseBase[axis] = (numerator[axis] >= 0)
                         ? numerator[axis] / denominator[axis]
                         : -((denominator[axis] - 1 - numerator[axis]) / denominator[axis]);
    }


    // --------------------------------------------------------
    // Interpolation weights.
    //
    // tx = 0   -> exactly at lower coarse point
    // tx = 0.5 -> halfway between coarse points
    // tx = 1   -> exactly at upper coarse point
    // --------------------------------------------------------

    vec3 t = vec3(numerator - coarseBase * denominator) / vec3(denominator);        


    // --------------------------------------------------------
    // Clamp the coarse indices.
    //
    // This prevents invalid memory access at boundaries.
    // Boundary-condition treatment itself is a separate issue.
    // --------------------------------------------------------

    ivec3 c000 = ivec3(
        clamp(coarseBase.x,     0, coarseDimensions.x - 1),
        clamp(coarseBase.y,     0, coarseDimensions.y - 1),
        clamp(coarseBase.z,     0, coarseDimensions.z - 1)
    );

    ivec3 c100 = ivec3(
        clamp(coarseBase.x + 1, 0, coarseDimensions.x - 1),
        clamp(coarseBase.y,     0, coarseDimensions.y - 1),
        clamp(coarseBase.z,     0, coarseDimensions.z - 1)
    );

    ivec3 c010 = ivec3(
        clamp(coarseBase.x,     0, coarseDimensions.x - 1),
        clamp(coarseBase.y + 1, 0, coarseDimensions.y - 1),
        clamp(coarseBase.z,     0, coarseDimensions.z - 1)
    );

    ivec3 c110 = ivec3(
        clamp(coarseBase.x + 1, 0, coarseDimensions.x - 1),
        clamp(coarseBase.y + 1, 0, coarseDimensions.y - 1),
        clamp(coarseBase.z,     0, coarseDimensions.z - 1)
    );

    ivec3 c001 = ivec3(
        clamp(coarseBase.x,     0, coarseDimensions.x - 1),
        clamp(coarseBase.y,     0, coarseDimensions.y - 1),
        clamp(coarseBase.z + 1, 0, coarseDimensions.z - 1)
    );

    ivec3 c101 = ivec3(
        clamp(coarseBase.x + 1, 0, coarseDimensions.x - 1),
        clamp(coarseBase.y,     0, coarseDimensions.y - 1),
        clamp(coarseBase.z + 1, 0, coarseDimensions.z - 1)
    );

    ivec3 c011 = ivec3(
        clamp(coarseBase.x,     0, coarseDimensions.x - 1),
        clamp(coarseBase.y + 1, 0, coarseDimensions.y - 1),
        clamp(coarseBase.z + 1, 0, coarseDimensions.z - 1)
    );

    ivec3 c111 = ivec3(
        clamp(coarseBase.x + 1, 0, coarseDimensions.x - 1),
        clamp(coarseBase.y + 1, 0, coarseDimensions.y - 1),
        clamp(coarseBase.z + 1, 0, coarseDimensions.z - 1)
    );


    // --------------------------------------------------------
    // Read coarse correction values
    // --------------------------------------------------------

    float v000 = coarseCorrection[index3D(c000, coarseDimensions)];

    float v100 = coarseCorrection[index3D(c100, coarseDimensions)];

    float v010 = coarseCorrection[index3D(c010, coarseDimensions)];

    float v110 = coarseCorrection[index3D(c110, coarseDimensions)];

    float v001 = coarseCorrection[index3D(c001, coarseDimensions)];

    float v101 = coarseCorrection[index3D(c101, coarseDimensions)];

    float v011 = coarseCorrection[index3D(c011, coarseDimensions)];

    float v111 = coarseCorrection[index3D(c111, coarseDimensions)];


    // --------------------------------------------------------
    // Trilinear interpolation
    // --------------------------------------------------------

    float interpolated =
          v000 * (1.0 - t.x) * (1.0 - t.y) * (1.0 - t.z)
        + v100 * t.x         * (1.0 - t.y) * (1.0 - t.z)
        + v010 * (1.0 - t.x) * t.y         * (1.0 - t.z)
        + v110 * t.x         * t.y         * (1.0 - t.z)
        + v001 * (1.0 - t.x) * (1.0 - t.y) * t.z
        + v101 * t.x         * (1.0 - t.y) * t.z
        + v011 * (1.0 - t.x) * t.y         * t.z
        + v111 * t.x         * t.y         * t.z;


    // --------------------------------------------------------
    // Add the coarse-grid correction to the existing fine
    // correction.
    // --------------------------------------------------------

    uint fineIndex = index3D(fineID, fineDimensions);

    fineCorrection[fineIndex] += interpolated;
}