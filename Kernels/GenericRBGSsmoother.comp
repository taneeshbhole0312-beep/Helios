#version 430 core

layout(local_size_x = 8,
       local_size_y = 8,
       local_size_z = 8) in;


// ============================================================
// Linear-system coefficients
// ============================================================

layout(std430, binding = 0)
buffer aPBuffer
{
    float aP[];
};

layout(std430, binding = 1)
buffer aWBuffer
{
    float aW[];
};

layout(std430, binding = 2)
buffer aEBuffer
{
    float aE[];
};

layout(std430, binding = 3)
buffer aSBuffer
{
    float aS[];
};

layout(std430, binding = 4)
buffer aNBuffer
{
    float aN[];
};

layout(std430, binding = 5)
buffer aBBuffer
{
    float aB[];
};

layout(std430, binding = 6)
buffer aTBuffer
{
    float aT[];
};


// ============================================================
// RHS
// ============================================================

layout(std430, binding = 7)
buffer RHSBuffer
{
    float RHS[];
};


// ============================================================
// Solution
// ============================================================

layout(std430, binding = 8)
buffer solutionBuffer
{
    float solution[];
};


// ============================================================
// Grid
// ============================================================

uniform int cells_x;
uniform int cells_y;
uniform int cells_z;


// ============================================================
// Red-Black color
// ============================================================

uniform int color;


void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;


    // --------------------------------------------------------
    // Bounds check
    // --------------------------------------------------------

    if (x >= uint(cells_x) ||
        y >= uint(cells_y) ||
        z >= uint(cells_z))
    {
        return;
    }


    // --------------------------------------------------------
    // Red-Black coloring
    // --------------------------------------------------------

    if (((x + y + z) & 1u) != uint(color))
    {
        return;
    }


    // --------------------------------------------------------
    // Linear index
    // --------------------------------------------------------

    uint layer_stride = uint(cells_x * cells_y);

    uint idx = z * layer_stride + y * uint(cells_x) + x;


    // --------------------------------------------------------
    // Current solution
    // --------------------------------------------------------

    float center = solution[idx];


    // --------------------------------------------------------
    // Neighbor indices
    //
    // At boundaries, use the center value.
    // This preserves the behavior of the existing pressure
    // smoother until boundary-equation handling is generalized.
    // --------------------------------------------------------

    float west = (x > 0u) ? solution[idx - 1u] : center;

    float east = (x < uint(cells_x - 1)) ? solution[idx + 1u] : center;

    float south = (y < uint(cells_y - 1)) ? solution[idx + uint(cells_x)] : center;

    float north = (y > 0u) ? solution[idx - uint(cells_x)] : center;

    float bottom = (z < uint(cells_z - 1)) ? solution[idx + layer_stride] : center;

    float top = (z > 0u) ? solution[idx - layer_stride] : center;


    // --------------------------------------------------------
    // Evaluate off-diagonal contribution
    //
    // aP*xP +
    // aW*xW +
    // aE*xE +
    // aS*xS +
    // aN*xN +
    // aB*xB +
    // aT*xT = RHS
    // --------------------------------------------------------

    float neighbor_contribution = aW[idx] * west + aE[idx] * east + aS[idx] * south + aN[idx] * north + aB[idx] * bottom + aT[idx] * top;


    // --------------------------------------------------------
    // Gauss-Seidel update
    // --------------------------------------------------------

    float new_solution = (RHS[idx] - neighbor_contribution) / aP[idx];


    solution[idx] = new_solution;
}