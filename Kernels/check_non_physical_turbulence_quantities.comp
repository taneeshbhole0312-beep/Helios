#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer KBUFFER
{
    float k[];
};

layout(std430, binding = 1) readonly buffer DESTRUCTION_VARIABLE
{
    float destruction_variable[];
};

layout(std430, binding = 2) buffer OUTPUT
{
    uint counts[];
};

uniform int cells_x;
uniform int cells_y;
uniform int cells_z;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x >= uint(cells_x) || y >= uint(cells_y) || z >= uint(cells_z))
        return;

    uint idx = z * (uint(cells_x) * uint(cells_y))
             + y * uint(cells_x)
             + x;

    if (k[idx] < 0.0 || isnan(k[idx]))
        atomicAdd(counts[0], 1u);

    if (destruction_variable[idx] < 0.0 || isnan(destruction_variable[idx]))
        atomicAdd(counts[1], 1u);
}