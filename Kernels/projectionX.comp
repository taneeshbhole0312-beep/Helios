#version 430 core

layout(local_size_x = 8,
       local_size_y = 8,
       local_size_z = 8) in;

layout(std430, binding = 0)
buffer PressureBuffer
{
    float pressure[];
};

layout(std430, binding = 1)
buffer MACVBuffer
{
    float MAC_v[];
};



uniform int cells_x;
uniform int cells_y;
uniform int cells_z;

uniform float cell_side_x;
uniform float stable_dt;
uniform float density;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    // vx grid: (cells_x + 1) columns, cells_y rows, cells_z layers
    if (x >= uint(cells_x + 1) ||
        y >= uint(cells_y) ||
        z >= uint(cells_z))
    {
        return;
    }

    uint v_idx = z * uint((cells_x + 1) * cells_y) + y * uint(cells_x + 1) + x;

    // start of this pressure row (pressure cells are cells_x * cells_y * cells_z)
    uint p_row = z * uint(cells_x * cells_y) + y * uint(cells_x);

    float p_l;
    float p_r;

    if (x > 0u)
    {
        uint left_idx  = p_row + (x - 1);   // cell to the left
        p_l = pressure[left_idx];
    }
    else
    {
        p_l = 0.0;
    }

    if (x < uint(cells_x))
    {
        uint right_idx = p_row + x;          // cell to the right


        p_r = pressure[right_idx];
    }
    else
    {
        p_r = 0.0;
    }

    float pressure_gradient_x = (p_r - p_l) / cell_side_x;

    MAC_v[v_idx] -= pressure_gradient_x * (stable_dt / density);

    if (x == 0u || x == uint(cells_x))
    {
        MAC_v[v_idx] = 0.0;
    }
}
